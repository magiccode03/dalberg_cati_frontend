    "conditional": "consent === '1'",
    "required": true,
    "min": 10,
    "max": 99,
    "placeholder": "Enter age",
    "rules": {
      "clearFields": {
        "age_validation": {
          "condition": "value < 18",
          "fields": [
            "resp_registered_voter",
            "resp_gender",
            "q5",
            "q6",
            "q7",
            "q8",
            "q9",
            "q10",
            "resp_religion",
            "resp_social_cat",
            "resp_caste_jati",
