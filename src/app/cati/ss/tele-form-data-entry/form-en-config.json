[
  {
    "type": "radio",
    "label": "Number Status",
    "required": true,
    "options": [
      {
        "label": "Call Not Received to Telecaller",
        "value": "3",
        "tag": "opt_call_not_received"
      },
      {
        "label": "Ringing (Respondent Call)",
        "value": "1",
        "tag": "opt_ringing"
      },
      {
        "label": "Not Ringing (Respondent Call)",
        "value": "2",
        "tag": "opt_not_ringing"
      }
    ],
    "rules": {
      "clearFields": {
        "opt_ringing": [
          "call_not_ring",
          "call_ring_status",
          "q_call_status",
          "call_reschedule",
          "consent",
          "resp_age",
          "resp_registered_voter",
          "resp_gender"
        ],
        "opt_not_ringing": [
          "call_ring_status",
          "q_call_status",
          "call_reschedule",
          "consent",
          "resp_age",
          "resp_registered_voter",
          "resp_gender"
        ],
        "opt_wrong_number": [
          "call_not_ring",
          "call_ring_status",
          "q_call_status",
          "call_reschedule",
          "consent",
          "resp_age",
          "resp_registered_voter",
          "resp_gender"
        ]
      },
      "showFields": {
        "opt_ringing": [
          "call_ring_status"
        ],
        "opt_not_ringing": [
          "call_not_ring"
        ]
      }
    },
    "tag": "number_status"
  },
  {
    "type": "radio",
    "label": "Call Not Ring Status",
    "conditional": "number_status === '2'",
    "options": [
      {
        "label": "Switched Off",
        "value": "1",
        "tag": "opt_switched_off"
      },
      {
        "label": "Number Not Reachable",
        "value": "2",
        "tag": "opt_number_not_reachable"
      },
      {
        "label": "Number Does not exist",
        "value": "3",
        "tag": "opt_number_does_not_exist"
      }
    ],
    "tag": "call_not_ring"
  },
  {
    "type": "radio",
    "label": "Call Ring Status",
    "conditional": "number_status === '1'",
    "options": [
      {
        "label": "Picked Up",
        "value": "1",
        "tag": "opt_picked_up"
      },
      {
        "label": "Did not picked",
        "value": "2",
        "tag": "opt_did_not_picked"
      }
    ],
    "rules": {
      "clearFields": {
        "opt_picked_up": [
          "q_call_status",
          "call_reschedule",
          "consent",
          "resp_age",
          "resp_registered_voter",
          "resp_gender"
        ],
        "opt_did_not_picked": [
          "q_call_status",
          "call_reschedule",
          "consent",
          "resp_age",
          "resp_registered_voter",
          "resp_gender"
        ]
      },
      "showFields": {
        "opt_picked_up": [
          "q_call_status"
        ]
      }
    },
    "tag": "call_ring_status"
  },
  {
    "type": "radio",
    "label": "Q Call Status",
    "conditional": "call_ring_status === '1'",
    "options": [
      {
        "label": "Continue",
        "value": "1",
        "tag": "opt_continue"
      },
      {
        "label": "Refuse to Respond",
        "value": "3",
        "tag": "opt_refuse_to_respond"
      },
      {
        "label": "Call Back Later",
        "value": "4",
        "tag": "opt_call_back_later"
      }
