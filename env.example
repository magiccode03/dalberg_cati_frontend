# ===========================================
# Election Analysis Dashboard
# Environment Variables Configuration
# ===========================================

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Application Name
# The display name for the application
NEXT_PUBLIC_APP_NAME=Election Analysis Dashboard

# Application Version
# Current version of the application
NEXT_PUBLIC_APP_VERSION=1.0.0

# Node Environment
# Options: development, production, test
NODE_ENV=development

# ===========================================
# API CONFIGURATION
# ===========================================

# API Base URL
# Backend API server URL
# Development: http://localhost:4001
# Production: https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:4001

# ===========================================
# AUTHENTICATION CONFIGURATION
# ===========================================

# NextAuth URL (if using NextAuth)
# The canonical URL of your site
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (if using NextAuth)
# Used to encrypt JWT tokens and other sensitive data
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# Enable Demo Mode
# Set to true to enable demo users and test data
NEXT_PUBLIC_DEMO_MODE=true

# Enable Debug Mode
# Set to true to enable detailed logging
NEXT_PUBLIC_DEBUG_MODE=false

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================

# Production API URL (override for production builds)
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Production App URL
# NEXTAUTH_URL=https://your-domain.com

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable User Management
# Allow SUPER ADMIN to manage users
NEXT_PUBLIC_ENABLE_USER_MANAGEMENT=true

# Enable Real-time Updates
# Enable WebSocket connections for real-time data
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true

# Enable Offline Mode
# Allow application to work offline
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Enable Analytics
# Enable usage analytics and tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ===========================================
# UI CONFIGURATION
# ===========================================

# Default Theme
# Options: light, dark, system
NEXT_PUBLIC_DEFAULT_THEME=light

# Default Language
# Options: en, hi
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Items Per Page
# Default number of items to display per page
NEXT_PUBLIC_ITEMS_PER_PAGE=10

# Max File Upload Size (in bytes)
# Default: 10MB
NEXT_PUBLIC_MAX_FILE_SIZE=10485760

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Token Refresh Threshold (in milliseconds)
# How long before token expiry to refresh (default: 5 minutes)
NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD=300000

# Session Timeout (in milliseconds)
# How long before session expires (default: 24 hours)
NEXT_PUBLIC_SESSION_TIMEOUT=86400000

# ===========================================
# DEMO USERS (Development Only)
# ===========================================

# These are the default demo users for development
# SUPER ADMIN: SUPER001 / SuperAdmin123!
# ADMIN: ADMIN001 / Admin123!
# PMT: PMT001 / PMT123!
# QC: QC001 / QC123!
# ANALYST: QA001 / Analyst123!

# ===========================================
# NOTES
# ===========================================

# 1. Copy this file to .env.local for local development
# 2. Copy this file to .env for production deployment
# 3. Never commit .env or .env.local files to version control
# 4. All NEXT_PUBLIC_ variables are exposed to the browser
# 5. Variables without NEXT_PUBLIC_ are server-side only
# 6. Update the API URLs according to your backend deployment
# 7. Generate secure secrets for production use
