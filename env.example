# ===========================================
# Election Analysis Dashboard
# Environment Variables Configuration
# ===========================================

# ===========================================
# USED ENVIRONMENT VARIABLES
# ===========================================

# API Base URL
# Backend API server URL
NEXT_PUBLIC_API_URL=http://localhost:4001

# Application Name
# The display name for the application
NEXT_PUBLIC_APP_NAME=Election Analysis Dashboard

# Application Version
# Current version of the application
NEXT_PUBLIC_APP_VERSION=1.0.0

# Node Environment
# Options: development, production, test
NODE_ENV=development

# ===========================================
# NOTES
# ===========================================

# 1. Copy this file to .env.local for local development
# 2. Copy this file to .env for production deployment
# 3. Never commit .env or .env.local files to version control
# 4. All NEXT_PUBLIC_ variables are exposed to the browser
